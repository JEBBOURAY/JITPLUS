{
  "name": "jitpluspro",
  "main": "expo-router/entry",
  "version": "1.7.1",
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "typescript"
      ]
    }
  },
  "scripts": {
    "eas-build-pre-install": "corepack enable",
    "adb-reverse": "node ../../scripts/adb-reverse.js",
    "prestart": "node ../../scripts/adb-reverse.js",
    "start": "cross-env EXPO_NO_DOCTOR=1 EXPO_OFFLINE=1 expo start --host lan --port 8082 --go --clear",
    "start:dev-client": "cross-env EXPO_NO_DOCTOR=1 expo start --host lan --port 8082 --dev-client --clear",
    "start:go": "cross-env EXPO_NO_DOCTOR=1 expo start --host lan --port 8082 --go --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix"
  },
  "dependencies": {
    "@expo-google-fonts/lexend": "^0.4.1",
    "@expo/dom-webview": "~58.0.2",
    "@expo/log-box": "~58.0.13",
    "@expo/metro-runtime": "~58.0.15",
    "@jitplus/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@sentry/cli": "3.4.0",
    "@sentry/react-native": "^8.29.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.90.24",
    "axios": "^1.13.6",
    "expo": "~58.0.19",
    "expo-apple-authentication": "~58.0.2",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-tracking-transparency": "~58.0.2",
    "expo-updates": "~58.0.18",
    "i18n-js": "^4.5.3",
    "lottie-react-native": "~7.5.0",
    "lucide-react-native": "^0.564.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-maps": "1.29.11",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "react-test-renderer": "19.3.0",
    "typescript": "~5.9.3"
  },
  "private": true
}
