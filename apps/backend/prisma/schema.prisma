// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [pg_trgm]
}

model Merchant {
  id                   String              @id @default(uuid())
  nom                  String              @db.VarChar(255)
  email                String              @unique @db.VarChar(255)
  password             String              @db.VarChar(255)
  googleId             String?             @unique @map("google_id") @db.VarChar(255)
  appleId              String?             @unique @map("apple_id") @db.VarChar(255)
  pushToken            String?             @map("push_token") @db.VarChar(512)
  language             String              @default("fr") @db.VarChar(5)
  termsAccepted        Boolean             @default(false) @map("terms_accepted")
  categorie            MerchantCategory
  secondaryCategories  MerchantCategory[]  @default([]) @map("secondary_categories")
  description          String?             @db.VarChar(1000)
  tagline              String?             @db.VarChar(120)
  badges               String[]            @default([])
  gallery              String[]            @default([])
  openingHours         Json?               @map("opening_hours")
  ville                String?             @db.VarChar(100)
  quartier             String?             @db.VarChar(100)
  adresse              String?             @db.VarChar(500)
  latitude             Float?
  longitude            Float?
  countryCode          String              @default("MA") @map("country_code") @db.VarChar(5)
  phoneNumber          String?             @map("phone_number") @db.VarChar(20)
  logoUrl              String?             @map("logo_url")
  coverUrl             String?             @map("cover_url")
  themeColor           String?             @map("theme_color") @db.VarChar(7) // hex color #RRGGBB
  themeIcon            String?             @map("theme_icon") @db.VarChar(32) // lucide icon slug
  cardBackgroundUrl    String?             @map("card_background_url") // optional image bg for loyalty card
  cardBackgroundColor  String?             @map("card_background_color") @db.VarChar(7) // optional solid hex bg #RRGGBB
  cardTextColor        String?             @map("card_text_color") @db.VarChar(5) // 'LIGHT' or 'DARK'
  socialLinks          Json?               @map("social_links") // {instagram, facebook, tiktok, website, snapchat, youtube}
  profileViews         Int                 @default(0) @map("profile_views")
  /// Purchase amount (currency units) that earns one stamp in PER_AMOUNT mode
  amountPerStamp       Float               @default(10) @map("amount_per_stamp")
  stampsForReward      Int                 @default(10) @map("stamps_for_reward")
  stampEarningMode     StampEarningMode    @default(PER_VISIT) @map("stamp_earning_mode")
  accumulationLimit    Int?                @map("accumulation_limit")
  /// Stamps are reset after this many days without a visit (null = never expire)
  stampValidityDays    Int?                @map("stamp_validity_days")
  /// Last change of stampValidityDays: the expiry countdown never starts before it
  stampValiditySince   DateTime?           @map("stamp_validity_since")
  activeRewardId       String?             @map("active_reward_id")
  /// Welcome gift: bonus stamps for a new client, credited on card add or at their first scan
  welcomeBonusEnabled  Boolean             @default(false) @map("welcome_bonus_enabled")
  welcomeBonusStamps   Int                 @default(1) @map("welcome_bonus_stamps")
  welcomeBonusTrigger  WelcomeBonusTrigger @default(CARD_OR_SCAN) @map("welcome_bonus_trigger")
  /// Days a client has to come after the reservation
  /// Last moment the offer can be reserved (null = no end date)
  welcomeBonusEndsAt   DateTime?           @map("welcome_bonus_ends_at")
  /// ISO 4217 code of the currency amounts are expressed in (MAD, XAF, XOF…)
  currency             String              @default("MAD") @db.VarChar(3)
  // Plan Freemium — les nouveaux marchands démarrent en FREE (le flow d'inscription attribue un essai PREMIUM via getTrialData())
  plan                 MerchantPlan        @default(FREE)
  planExpiresAt        DateTime?           @map("plan_expires_at")
  planActivatedByAdmin Boolean             @default(false) @map("plan_activated_by_admin")
  trialStartedAt       DateTime?           @map("trial_started_at")
  /// One of the first FOUNDING_MEMBERS_LIMIT sign-ups: permanent free PREMIUM, the Pro app hides every plan/Premium surface
  foundingMember       Boolean             @default(false) @map("founding_member")

  isActive            Boolean   @default(true) @map("is_active")
  emailVerified       Boolean   @default(false) @map("email_verified")
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  // Déprécié : plus lu ni écrit. À supprimer (DROP COLUMN) au prochain déploiement, une fois l'ancienne révision retirée.
  welcomeGuideVisible Boolean   @default(false) @map("welcome_guide_visible")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  // ── Préférences notifications (crons marketing / opt-out RGPD) ──
  notifPush           Boolean   @default(true) @map("notif_push")
  notifEmail          Boolean   @default(true) @map("notif_email")
  /// Per-category push opt-outs {news, tips, reminders, reports}: a missing key means ON.
  /// Plan, quota, status and security pushes ignore it.
  notifPrefs          Json?     @map("notif_prefs")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  // ── Programme de parrainage ──
  referralCode          String?    @unique @map("referral_code")
  referredById          String?    @map("referred_by_id")
  referredBy            Merchant?  @relation("MerchantReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals             Merchant[] @relation("MerchantReferrals")
  referralMonthsEarned  Int        @default(0) @map("referral_months_earned")
  referralBonusCredited Boolean    @default(false) @map("referral_bonus_credited")

  loyaltyCards    LoyaltyCard[]
  transactions    Transaction[]
  welcomeBonusClaims WelcomeBonusClaim[]
  rewards         Reward[]
  notifications   Notification[]
  teamMembers     TeamMember[]
  deviceSessions  DeviceSession[]
  stores          Store[]
  profileViewsLog ProfileView[]
  clientReferral  ClientReferral[]

  // ── Parrainage par client ──
  referredByClientId String? @map("referred_by_client_id")
  referredByClient   Client? @relation("ClientMerchantReferrals", fields: [referredByClientId], references: [id], onDelete: SetNull)

  // Champs pour le quota WhatsApp
  whatsappQuotaUsed    Int      @default(0)
  whatsappQuotaMax     Int      @default(100)
  whatsappQuotaResetAt DateTime @default(now())

  // Champs pour le quota Email
  emailQuotaUsed    Int      @default(0)
  emailQuotaMax     Int      @default(200)
  emailQuotaResetAt DateTime @default(now())

  // Admin notifications
  lastAdminNotifReadAt DateTime?                   @map("last_admin_notif_read_at")
  notificationReads    MerchantNotificationRead[]
  inboxNotifications   MerchantInboxNotification[]

  // Lucky Wheel campaigns
  luckyWheelCampaigns LuckyWheelCampaign[]

  // Client-side blocks (App Store 1.2 compliance)
  blockedByClients ClientMerchantBlock[]

  // Campaign dedup tracker (marketing push/email crons)
  campaignSentTrackers CampaignSentTracker[] @relation("MerchantCampaignSentTrackers")

  // Quick-add anonymous client claim links (WhatsApp friction-zero onboarding)
  clientClaims ClientClaim[]

  // Scratch-card campaigns and the coupons they produce
  scratchCampaigns ScratchCampaign[]
  coupons          Coupon[]

  // Collection game (buy every product of a set, win a chosen gift)
  collections Collection[]

  // Public promotions ("bons plans")
  deals Deal[]

  // Single-use QR codes slipped into e-commerce parcels
  stampCodes StampCode[]

  // ── Admin back-office ──
  /// How the current admin-activated PREMIUM was granted (null = trial, FREE, or not recorded)
  premiumGrant         PremiumGrant?                 @map("premium_grant")
  /// Why PREMIUM was offered for free, or a note on the deal
  premiumGrantNote     String?                       @map("premium_grant_note") @db.VarChar(300)
  followUp             MerchantFollowUp?
  followUpNotes        MerchantFollowUpNote[]
  subscriptionPayments MerchantSubscriptionPayment[]

  // ── Booking ──
  bookingSettings        BookingSettings?
  bookableServices       BookableService[]
  bookingResources       BookingResource[]
  availabilityExceptions AvailabilityException[]
  bookings               Booking[]

  @@index([deletedAt])
  // Discovery queries filter by category + city — composite index avoids full table scans
  @@index([categorie, ville, isActive])
  // Geospatial proximity queries (nearby merchants)
  @@index([latitude, longitude])
  // Admin dashboard: count by plan / filter active+plan → [isActive, plan] and [plan, isActive, createdAt]
  @@index([isActive, plan])
  // Admin list filtering: plan + active + date sort
  @@index([plan, isActive, createdAt(sort: Desc)])
  // Referral analytics: count + list merchants referred by another merchant
  @@index([referredById])
  // Merchant-lifecycle cron: scan PREMIUM merchants with expiring plan (partial index added via raw SQL in migration)
  @@index([plan, planExpiresAt])
  // Trial reminders cron: scan merchants on trial sorted by start date (partial index added via raw SQL in migration)
  @@index([trialStartedAt])
  // FK referred_by_client_id (ON DELETE SET NULL): client deletion / referral lookups.
  @@index([referredByClientId])
  @@map("merchants")
}

model Store {
  id          String            @id @default(uuid())
  merchantId  String            @map("merchant_id")
  nom         String            @db.VarChar(255)
  description String?           @db.VarChar(1000)
  categorie   MerchantCategory?
  ville       String?           @db.VarChar(100)
  quartier    String?           @db.VarChar(100)
  adresse     String?           @db.VarChar(500)
  latitude    Float?
  longitude   Float?
  telephone   String?           @db.VarChar(20)
  email       String?           @db.VarChar(255)
  logoUrl     String?           @map("logo_url")
  coverUrl    String?           @map("cover_url")
  socialLinks Json?             @map("social_links")
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  dealStores DealStore[]

  bookingResources BookingResource[]

  // Active store lookups by merchant (discovery + nearby)
  @@index([merchantId, isActive])
  // Geospatial store queries for nearby search
  @@index([isActive, latitude, longitude])
  @@map("stores")
}

model Admin {
  id                  String    @id @default(uuid())
  email               String    @unique @db.VarChar(255)
  password            String    @db.VarChar(255)
  nom                 String    @db.VarChar(255)
  role                AdminRole @default(ADMIN)
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  /// Admin JWTs issued before this instant are rejected (logout). Stored in the
  /// database so revocation holds on every instance and survives restarts.
  tokensValidAfter    DateTime? @map("tokens_valid_after")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@map("admins")
}

enum MerchantCategory {
  CAFE
  RESTAURANT
  EPICERIE
  BOULANGERIE
  PHARMACIE
  LIBRAIRIE
  VETEMENTS
  ELECTRONIQUE
  COIFFURE
  BEAUTE
  SPORT
  SUPERMARCHE
  BOUCHERIE
  PATISSERIE
  FASTFOOD
  HAMMAM
  ANIMALERIE
  FLEURISTE
  BIJOUTERIE
  OPTIQUE
  TELEPHONE
  BRICOLAGE
  AUTO
  HOTEL
  PARFUMERIE
  TRAITEUR
  LOCATION_VOITURE
  SALLE_JEU
  AUTRE
}

enum AdminRole {
  ADMIN
}

// ── Audit log action catalogue ────────────────────────────────
enum AuditAction {
  // Auth
  ADMIN_LOGIN
  // Plan management
  ACTIVATE_PREMIUM
  REVOKE_PREMIUM
  // Merchant lifecycle
  BAN_MERCHANT
  UNBAN_MERCHANT
  DELETE_MERCHANT
  // Client lifecycle
  DEACTIVATE_CLIENT
  ACTIVATE_CLIENT
  DELETE_CLIENT
  // Admin notifications
  ADMIN_SEND_NOTIFICATION
  // Merchant operations (auditable for compliance)
  CREATE_REWARD
  DELETE_REWARD
  CREATE_TEAM_MEMBER
  DELETE_TEAM_MEMBER
  CREATE_STORE
  DELETE_STORE
  CANCEL_TRANSACTION
  UPDATE_LOYALTY_SETTINGS
  CREATE_SCRATCH_CAMPAIGN
  CANCEL_SCRATCH_CAMPAIGN
  REDEEM_COUPON
  CREATE_DEAL
  REMOVE_DEAL
  RESTORE_DEAL
  CREATE_STAMP_CODES
  REVOKE_STAMP_CODES
  // Future-proof slots
  RESET_PASSWORD
  UPDATE_PLAN_DURATION
  UPDATE_PAYOUT
  // Back-office billing
  RECORD_SUBSCRIPTION_PAYMENT
  VOID_SUBSCRIPTION_PAYMENT
  UPDATE_PREMIUM_GRANT
}

enum AuditTargetType {
  MERCHANT
  CLIENT
  ADMIN
}

enum AuditActorType {
  ADMIN
  MERCHANT
}

// ── Sign-up funnel (JitPlus client app) ───────────────────────
/// One counter per day (Morocco time), step, sign-up method and platform.
/// Holds no personal data: it only says how many people reached each step.
model SignupFunnelDaily {
  day      DateTime @db.Date
  step     String   @db.VarChar(32)
  method   String   @db.VarChar(10)
  platform String   @db.VarChar(10)
  count    Int      @default(0)

  @@id([day, step, method, platform])
  @@map("signup_funnel_daily")
}

// ── Audit log table ───────────────────────────────────────────
model AuditLog {
  id          String          @id @default(uuid())
  /// Type of actor: ADMIN or MERCHANT
  actorType   AuditActorType  @default(ADMIN) @map("actor_type")
  /// Admin who performed the action (nullable for merchant-initiated actions)
  adminId     String?         @map("admin_id")
  /// SetNull, not Cascade: deleting an admin must not erase its audit trail
  /// (adminEmail keeps who acted).
  admin       Admin?          @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminEmail  String?         @map("admin_email")
  /// Merchant who performed the action (nullable for admin-initiated actions)
  merchantId  String?         @map("merchant_id")
  action      AuditAction
  /// Type of resource affected: "MERCHANT", "CLIENT", "ADMIN"
  targetType  AuditTargetType @map("target_type")
  /// PK of the affected resource (nullable for login events)
  targetId    String?         @map("target_id")
  /// Human-readable label (e.g. merchant name + email) for quick read
  targetLabel String?         @map("target_label")
  /// Extra context as JSON (old plan, new plan, reason, …)
  metadata    Json?
  /// Client IP address of the actor
  ipAddress   String?         @map("ip_address")
  userAgent   String?         @map("user_agent")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([merchantId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt(sort: Desc)])
  @@index([adminId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

enum MerchantPlan {
  FREE
  PREMIUM
}

enum StampEarningMode {
  PER_VISIT
  PER_AMOUNT
}

enum WelcomeBonusTrigger {
  /// Reserved when the client adds the card from the merchant page, or at the first scan
  CARD_OR_SCAN
  /// Reserved at the first scan only
  FIRST_SCAN
}

model Client {
  id                    String    @id @default(uuid())
  prenom                String?   @db.VarChar(255)
  nom                   String?   @db.VarChar(255)
  email                 String?   @unique @db.VarChar(255)
  emailVerified         Boolean   @default(false) @map("email_verified")
  password              String?   @db.VarChar(255)
  telephone             String?   @unique @db.VarChar(20)
  telephoneVerified     Boolean   @default(false) @map("telephone_verified")
  googleId              String?   @unique @map("google_id") @db.VarChar(255)
  appleId               String?   @unique @map("apple_id") @db.VarChar(255)
  countryCode           String    @default("MA") @map("country_code") @db.VarChar(5)
  pushToken             String?   @map("push_token") @db.VarChar(512)
  refreshTokenHash      String?   @unique @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  termsAccepted         Boolean   @default(false) @map("terms_accepted")
  /// Proof of consent: when the terms were accepted and which version. Null on accounts older than these columns.
  termsAcceptedAt       DateTime? @map("terms_accepted_at")
  termsVersion          String?   @map("terms_version") @db.VarChar(20)
  shareInfoMerchants    Boolean   @default(true) @map("share_info_merchants")
  notifPush             Boolean   @default(true) @map("notif_push")
  notifEmail            Boolean   @default(true) @map("notif_email")
  notifWhatsapp         Boolean   @default(false) @map("notif_whatsapp")
  language              String    @default("fr") @db.VarChar(5)
  dateNaissance         DateTime? @map("date_naissance")
  failedLoginAttempts   Int       @default(0) @map("failed_login_attempts")
  lockedUntil           DateTime? @map("locked_until")
  // Marker for "ghost" accounts created by a merchant on behalf of a
  // walk-in client (Quick-Add via WhatsApp). Becomes false after the
  // client claims their loyalty history through the deep link.
  isAnonymous           Boolean   @default(false) @map("is_anonymous")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  // ── Alertes bons plans ──
  dealAlertsEnabled   Boolean            @default(false) @map("deal_alerts_enabled")
  /// MOROCCO_CITIES key; only the city is stored, never the position (loi 09-08)
  dealAlertCityKey    String?            @map("deal_alert_city_key") @db.VarChar(40)
  dealAlertCategories MerchantCategory[] @default([]) @map("deal_alert_categories")
  dealOnlineAlerts    Boolean            @default(true) @map("deal_online_alerts")

  // ── Programme de parrainage client ──
  referralCode    String? @unique @map("referral_code")
  referralBalance Float   @default(0) @map("referral_balance")

  loyaltyCards         LoyaltyCard[]
  transactions         Transaction[]
  notificationStatuses ClientNotificationStatus[]
  profileViewsLog      ProfileView[]
  clientReferrals      ClientReferral[]
  referredMerchants    Merchant[]                 @relation("ClientMerchantReferrals")
  payoutRequests       PayoutRequest[]
  luckyWheelTickets    LuckyWheelTicket[]
  campaignSentTrackers CampaignSentTracker[]
  merchantBlocks       ClientMerchantBlock[]
  clientClaims         ClientClaim[]
  scratchCards         ScratchCard[]
  coupons              Coupon[]
  collectionProgress   CollectionProgress[]
  sessions            ClientSession[]
  dealReports          DealReport[]
  dealClaims           DealClaim[]
  dealSaves            DealSave[]
  stampCodes           StampCode[]
  bookings             Booking[]

  @@index([nom])
  // Client search is ILIKE '%term%' (buildClientSearchFilter): only trigram indexes serve it
  @@index([prenom(ops: raw("gin_trgm_ops"))], type: Gin, map: "clients_prenom_trgm_idx")
  @@index([nom(ops: raw("gin_trgm_ops"))], type: Gin, map: "clients_nom_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "clients_email_trgm_idx")
  @@index([telephone(ops: raw("gin_trgm_ops"))], type: Gin, map: "clients_telephone_trgm_idx")
  @@index([deletedAt, createdAt])
  @@index([countryCode])
  // refreshTokenHash is @unique — implicit index
  // Broadcast-optimised: covers WHERE notifPush=true AND deletedAt IS NULL AND pushToken IS NOT NULL
  @@index([notifPush, deletedAt, pushToken])
  // Token lookups: dedup on registration (updatePushToken) and stale-token cleanup (pushToken IN …)
  @@index([pushToken])
  // Daily deal digest: subscribers of a city, read in id order batch by batch
  @@index([dealAlertsEnabled, dealAlertCityKey, id])
  @@map("clients")
}

/// One row per welcome gift and verified client identity (email, phone, Google,
/// Apple), so the gift stays "already received" after the account is deleted
/// and recreated (a new client id has no transaction history). Only a keyed
/// HMAC of the identity is stored, never the identity itself, and rows are not
/// linked to the client: deleting the account still removes its personal data.
model WelcomeBonusClaim {
  id           String   @id @default(uuid())
  merchantId   String   @map("merchant_id")
  identityHash String   @map("identity_hash") @db.Char(64)
  createdAt    DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, identityHash])
  @@map("welcome_bonus_claims")
}

model Otp {
  id        String   @id @default(uuid())
  telephone String?  @unique
  email     String?  @unique
  code      String
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt, createdAt(sort: Desc)])
  @@map("otps")
}

/// Single-use nonces for v2 QR tokens. A successful scan consumes the nonce so the
/// same QR cannot be replayed. Expired rows are pruned opportunistically on insert
/// and (optionally) by a periodic task.
/// Socket.IO payloads larger than 8 kB, relayed between Cloud Run instances by
/// @socket.io/postgres-adapter (src/events/postgres-io.adapter.ts), which
/// inserts, reads and purges this table itself. Schema fixed by the adapter.
model SocketIoAttachment {
  id        BigInt    @unique @default(autoincrement())
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  payload   Bytes?

  @@map("socket_io_attachments")
}

/// One row per (cron, scheduled minute). With several Cloud Run instances the
/// instance whose INSERT succeeds runs the job; the others see the conflict
/// and skip. Rows older than 30 days are purged opportunistically.
model CronRun {
  name String   @db.VarChar(100)
  slot DateTime

  @@id([name, slot])
  @@index([slot])
  @@map("cron_runs")
}

/// OTP codes sent per identifier (email / phone) and UTC day, shared by every
/// instance so the daily cap holds across instances and restarts.
model OtpSendCounter {
  identifier String   @db.VarChar(320)
  day        DateTime @db.Date
  count      Int      @default(0)

  @@id([identifier, day])
  @@index([day])
  @@map("otp_send_counters")
}

model QrNonce {
  nonce     String   @id @db.VarChar(64)
  clientId  String   @map("client_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@index([clientId])
  @@map("qr_nonces")
}

/// Magic-link claim tokens created when a merchant adds stamps for a walk-in
/// client (Quick-Add via WhatsApp). The raw token never hits the DB — only its
/// SHA-256 digest. On claim, the anonymous Client's loyalty data is merged
/// into the real registered Client and this row is marked consumed.
model ClientClaim {
  id            String    @id @default(uuid())
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  clientId      String    @map("client_id")
  merchantId    String    @map("merchant_id")
  createdByName String?   @map("created_by_name") @db.VarChar(255)
  expiresAt     DateTime  @map("expires_at")
  consumedAt    DateTime? @map("consumed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([expiresAt])
  @@index([clientId, consumedAt])
  @@map("client_claims")
}

model LoyaltyCard {
  id                         String    @id @default(uuid())
  clientId                   String    @map("client_id")
  merchantId                 String    @map("merchant_id")
  stamps                     Int       @default(0)
  /// Last EARN_STAMPS / REDEEM_REWARD / PURCHASE: reference for stamp expiry
  lastVisitAt                DateTime  @default(now()) @map("last_visit_at")
  /// Set when the "stamps expire soon" push was sent; cleared on the next visit
  expiryReminderSentAt       DateTime? @map("expiry_reminder_sent_at")
  /// Welcome gift reserved by a till entry without proof of the client. Kept out of `stamps`
  /// until their first scan credits it. Each date is written once, never cleared.
  welcomeBonusReservedStamps Int       @default(0) @map("welcome_bonus_reserved_stamps")
  welcomeBonusReservedAt     DateTime? @map("welcome_bonus_reserved_at")
  welcomeBonusCreditedAt     DateTime? @map("welcome_bonus_credited_at")
  /// Card created by the merchant from a typed phone number (no proof of the client's
  /// consent): the client's name/email/phone stay masked until the client confirms
  /// (QR scan, joining in the app, e-commerce code, booking).
  consentPending             Boolean   @default(false) @map("consent_pending")
  deactivatedAt              DateTime? @map("deactivated_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  client   Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@unique([clientId, merchantId])
  // Client-side wallet view: list active cards for a client (filter deactivatedAt IS NULL)
  @@index([clientId, deactivatedAt])
  @@index([merchantId, createdAt])
  // Accumulation cap queries: fetch cards over limit for a merchant
  @@index([merchantId, stamps])
  // Broadcast notification: cursor-paginated lookup of active cards per merchant
  @@index([merchantId, deactivatedAt, clientId])
  // Stamp expiry cron: cards of a merchant ordered by last visit
  @@index([merchantId, lastVisitAt])
  @@map("loyalty_cards")
}

model Transaction {
  id              String            @id @default(uuid())
  clientId        String            @map("client_id")
  merchantId      String            @map("merchant_id")
  rewardId        String?           @map("reward_id")
  teamMemberId    String?           @map("team_member_id")
  performedByName String?           @map("performed_by_name")
  type            TransactionType
  note            String?
  amount          Float             @default(0)
  stamps          Int
  status          TransactionStatus @default(ACTIVE)
  giftStatus      GiftStatus?       @map("gift_status")
  fulfilledAt     DateTime?         @map("fulfilled_at")
  /// Optional client-supplied key (UUIDv4) that dedupes safe retries of POST /merchant/transactions.
  /// Unique per merchant via a partial index (allows NULL for rows created without a key).
  idempotencyKey  String?           @map("idempotency_key") @db.VarChar(64)
  /// Set when the stamps came from an e-commerce QR code (parcel / delivery)
  stampCodeId     String?           @unique @map("stamp_code_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  client            Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  merchant          Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  reward            Reward?            @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  teamMember        TeamMember?        @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  luckyWheelTickets LuckyWheelTicket[]
  stampCode         StampCode?         @relation(fields: [stampCodeId], references: [id], onDelete: SetNull)

  @@index([merchantId, status, createdAt])
  @@index([clientId, status, createdAt])
  // Lucky-wheel "every N visits" count: client + merchant + type + date
  @@index([clientId, merchantId, type, createdAt])
  @@index([merchantId, type, status, createdAt])
  @@index([rewardId])
  // Activity feed per team member ("who scanned what")
  @@index([teamMemberId, createdAt(sort: Desc)])
  // Admin dashboard: count by type, filter status+date
  @@index([type])
  @@index([status, createdAt(sort: Desc)])
  // Pending gifts lookup: quickly find PENDING gifts for a merchant
  @@index([merchantId, giftStatus, createdAt])
  // Dashboard + transaction history: merchant sorted by date
  @@index([merchantId, createdAt(sort: Desc)])
  // Idempotency lookup: served by the partial unique index transactions_merchant_id_idempotency_key_unique (raw SQL, migration 20260424120000).
  @@map("transactions")
}

enum TransactionType {
  EARN_STAMPS
  REDEEM_REWARD
  ADJUST_STAMPS
  /// Informational history entry (0 stamps), e.g. the points → stamps conversion
  LOYALTY_PROGRAM_CHANGE
  LUCKY_WHEEL_WIN
  /// Purchase recorded without stamps (0 stamps) because it only reaches a lucky-wheel minimum spend
  PURCHASE
  /// Coupon used at the till (stamps = bonus stamps for BONUS_STAMPS coupons, 0 otherwise)
  COUPON_REDEEM
  /// Welcome gift credited on card add or at the first scan. At most one per client and merchant
  /// (partial unique index transactions_welcome_bonus_unique, raw SQL migration).
  WELCOME_BONUS
}

enum TransactionStatus {
  ACTIVE
  CANCELLED
}

enum GiftStatus {
  PENDING
  FULFILLED
}

enum TeamRole {
  TEAM_MEMBER
}

model TeamMember {
  id                  String    @id @default(uuid())
  merchantId          String    @map("merchant_id")
  nom                 String    @db.VarChar(255)
  email               String    @unique @db.VarChar(255)
  password            String    @db.VarChar(255)
  role                TeamRole  @default(TEAM_MEMBER)
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  bookingResource BookingResource?

  @@index([merchantId])
  @@map("team_members")
}

model Reward {
  id          String   @id @default(uuid())
  merchantId  String   @map("merchant_id")
  titre       String   @db.VarChar(255)
  cout        Int
  description String?  @db.VarChar(1000)
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  merchant       Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  scratchRewards ScratchReward[]

  @@index([merchantId])
  @@map("rewards")
}

/// Channel used for a notification blast (stored as TEXT in DB).
/// Values: 'PUSH', 'EMAIL', 'WHATSAPP'

model Notification {
  id             String   @id @default(uuid())
  merchantId     String?  @map("merchant_id")
  title          String   @db.VarChar(255)
  body           String   @db.VarChar(2000)
  recipientCount Int      @default(0) @map("recipient_count")
  successCount   Int      @default(0) @map("success_count")
  failureCount   Int      @default(0) @map("failure_count")
  isBroadcast    Boolean  @default(false) @map("is_broadcast")
  channel        String?  @map("channel")
  audience       String?  @map("audience") @db.VarChar(30)
  /// Deep link for the client feed: routing keys of the push payload (event, action, target ids).
  data           Json?    @map("data")
  createdAt      DateTime @default(now()) @map("created_at")

  merchant       Merchant?                  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  clientStatuses ClientNotificationStatus[]
  merchantReads  MerchantNotificationRead[]

  @@index([channel, createdAt(sort: Desc)])
  // Admin stats: groupBy channel filtered by audience
  @@index([channel, audience, createdAt(sort: Desc)])
  // Merchant history + client notification list: merchantId + createdAt DESC
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([audience, createdAt(sort: Desc)])
  // Merchant broadcast history and client feed broadcasts: skips the per-scan
  // personal rows that dominate a merchant's notifications.
  @@index([merchantId, isBroadcast, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Per-merchant notification read status for admin broadcast notifications.
model MerchantNotificationRead {
  merchantId     String   @map("merchant_id")
  notificationId String   @map("notification_id")
  readAt         DateTime @default(now()) @map("read_at")

  merchant     Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([merchantId, notificationId])
  @@index([notificationId])
  @@map("merchant_notification_reads")
}

/// Personal inbox of a merchant: every automatic push sent to the Pro app
/// (security, plan, activity, tips…) is recorded here so it also appears in
/// the in-app Notifications screen, next to admin broadcasts.
/// category: 'SECURITY' | 'PLAN' | 'STATUS' | 'QUOTA' | 'ACTIVITY' | 'TIP' | 'SETUP' | 'OFFER' | 'NEWS' | 'REMINDER'
/// action: deep-link key handled by the Pro app (e.g. 'open_plan').
model MerchantInboxNotification {
  id         String    @id @default(uuid())
  merchantId String    @map("merchant_id")
  category   String    @db.VarChar(20)
  title      String    @db.VarChar(255)
  body       String    @db.VarChar(2000)
  action     String?   @db.VarChar(40)
  readAt     DateTime? @map("read_at")
  /// Set when the merchant opened the app from the push itself (open-rate tracking)
  openedAt   DateTime? @map("opened_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt(sort: Desc)])
  @@index([merchantId, readAt])
  @@index([createdAt])
  @@map("merchant_inbox_notifications")
}

/// Per-client notification status: tracks read/dismissed state.
model ClientNotificationStatus {
  id             String    @id @default(uuid())
  clientId       String    @map("client_id")
  notificationId String    @map("notification_id")
  isRead         Boolean   @default(false) @map("is_read")
  readAt         DateTime? @map("read_at")
  isDismissed    Boolean   @default(false) @map("is_dismissed")
  dismissedAt    DateTime? @map("dismissed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([clientId, notificationId])
  @@index([clientId, isDismissed])
  @@index([clientId, isRead])
  // Broadcast history read counts (notificationId IN … AND isRead); its prefix
  // also serves every lookup the former [notificationId] index did.
  @@index([notificationId, isRead])
  @@map("client_notification_statuses")
}

/// Tracks emails/campaigns already sent to clients OR merchants to prevent duplicates.
/// Exactly one of (clientId, merchantId) must be set — enforced in app layer.
model CampaignSentTracker {
  id         String   @id @default(uuid())
  clientId   String?  @map("client_id")
  merchantId String?  @map("merchant_id")
  campaignId String   @map("campaign_id") // ID of the specific email series/day
  channel    String   @default("EMAIL") // EMAIL, WHATSAPP, PUSH
  sentAt     DateTime @default(now()) @map("sent_at")

  client   Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  merchant Merchant? @relation("MerchantCampaignSentTrackers", fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([clientId, campaignId, channel])
  @@unique([merchantId, campaignId, channel])
  @@index([campaignId])
  // Retention cleanup: purge old rows
  @@index([sentAt])
  @@map("campaign_sent_trackers")
}

model DeviceSession {
  id              String   @id @default(uuid())
  merchantId      String   @map("merchant_id")
  tokenId         String?  @unique @map("token_id")
  deviceId        String?  @map("device_id")
  deviceName      String   @map("device_name")
  deviceOS        String?  @map("device_os")
  userType        String?  @map("user_type")
  userEmail       String?  @map("user_email")
  userName        String?  @map("user_name")
  lastActiveAt    DateTime @default(now()) @map("last_active_at")
  ipAddress       String?  @map("ip_address")
  isCurrentDevice Boolean  @default(false) @map("is_current_device")
  createdAt       DateTime @default(now()) @map("created_at")

  refreshTokenHash String? @map("refresh_token_hash")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, deviceId])
  @@index([merchantId, deviceName])
  // Active sessions list: "ORDER BY lastActiveAt DESC" per merchant
  @@index([merchantId, lastActiveAt(sort: Desc)])
  @@map("device_sessions")
}

// One row per logged-in client device, so several devices can stay signed in
// at once. The refresh token is rotated in place on every refresh.
model ClientSession {
  id                       String    @id @default(uuid())
  clientId                 String    @map("client_id")
  refreshTokenHash         String    @unique @map("refresh_token_hash")
  expiresAt                DateTime  @map("expires_at")
  lastUsedAt               DateTime  @default(now()) @map("last_used_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  /// Set when the session was opened by an email OTP login: proof of inbox
  /// ownership that authorises ONE password reset shortly after (consumed).
  otpVerifiedAt            DateTime? @map("otp_verified_at")
  /// Token replaced by the last rotation, accepted a few seconds after `rotatedAt`
  /// in case the answer to that refresh never reached the app.
  previousRefreshTokenHash String?   @unique @map("previous_refresh_token_hash")
  rotatedAt                DateTime? @map("rotated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, lastUsedAt(sort: Desc)])
  @@map("client_sessions")
}

// ── Profile view tracking (one view per client per merchant per day) ──
model ProfileView {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  clientId   String   @map("client_id")
  viewDate   DateTime @map("view_date") @db.Date
  createdAt  DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([merchantId, clientId, viewDate])
  @@index([merchantId, viewDate])
  @@index([clientId])
  @@map("profile_views_log")
}

// ── Parrainage client → commerce ─────────────────────────────────────────────
enum ClientReferralStatus {
  PENDING
  VALIDATED
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PayoutMethod {
  BANK_TRANSFER
  CASH
}

model ClientReferral {
  id          String               @id @default(uuid())
  clientId    String               @map("client_id")
  merchantId  String               @unique @map("merchant_id")
  status      ClientReferralStatus @default(PENDING)
  amount      Float                @default(0)
  validatedAt DateTime?            @map("validated_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@map("client_referrals")
}

model PayoutRequest {
  id              String       @id @default(uuid())
  clientId        String       @map("client_id")
  amount          Float
  status          PayoutStatus @default(PENDING)
  method          PayoutMethod
  accountDetails  Json?        @map("account_details")
  rejectionReason String?      @map("rejection_reason")
  approvedAt      DateTime?    @map("approved_at")
  rejectedAt      DateTime?    @map("rejected_at")
  paidAt          DateTime?    @map("paid_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  // Client payout history filtered by status (most recent first)
  @@index([clientId, status, createdAt(sort: Desc)])
  @@map("payout_requests")
}

// ══════════════════════════════════════════════════════════════════════════════
// ── Lucky Wheel (promotional prize wheel, free to play) ──────────────────────
// ══════════════════════════════════════════════════════════════════════════════

/// Status of a lucky-wheel campaign
enum LuckyWheelCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

/// Result of a single draw
enum DrawResult {
  WON
  LOST
}

/// Status of a won prize (fulfilment lifecycle)
enum PrizeFulfilmentStatus {
  PENDING
  CLAIMED
  EXPIRED
}

/// A promotional prize-wheel campaign created by a merchant
model LuckyWheelCampaign {
  id                 String                   @id @default(uuid())
  merchantId         String                   @map("merchant_id")
  name               String                   @db.VarChar(255)
  description        String?                  @db.VarChar(2000)
  status             LuckyWheelCampaignStatus @default(DRAFT)
  /// Overall probability of winning ANY prize (0.0–1.0). Remainder = "Pas de chance".
  globalWinRate      Float                    @default(0.5) @map("global_win_rate")
  startsAt           DateTime                 @map("starts_at")
  endsAt             DateTime                 @map("ends_at")
  /// Minimum stamps a client must spend (REDEEM_REWARD) to earn a ticket
  ticketCostStamps   Int                      @default(0) @map("ticket_cost_stamps")
  /// Or: earn a ticket on every N-th visit
  ticketEveryNVisits Int?                     @map("ticket_every_n_visits")
  /// Minimum purchase amount (in currency) required to earn a lucky-wheel ticket
  minSpendAmount     Int                      @default(0) @map("min_spend_amount")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  merchant Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  prizes   LuckyWheelPrize[]
  tickets  LuckyWheelTicket[]

  @@index([merchantId, status])
  @@index([status, startsAt, endsAt])
  @@map("lucky_wheel_campaigns")
}

/// A prize tier within a campaign (weighted probability + stock management)
model LuckyWheelPrize {
  id               String   @id @default(uuid())
  campaignId       String   @map("campaign_id")
  label            String   @db.VarChar(255)
  description      String?  @db.VarChar(1000)
  /// Relative weight for the weighted-random algorithm (higher = more likely among prizes)
  weight           Int      @default(1)
  /// Total stock for this prize
  totalStock       Int      @map("total_stock")
  /// Remaining stock (decremented atomically on each win)
  remaining        Int
  /// How long the client has to claim the prize (hours). Null = no expiry.
  claimWindowHours Int?     @map("claim_window_hours")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  campaign LuckyWheelCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  draws    LuckyWheelDraw[]

  @@index([campaignId, remaining])
  @@map("lucky_wheel_prizes")
}

/// A ticket earned by a client, linked to a real transaction
model LuckyWheelTicket {
  id            String   @id @default(uuid())
  campaignId    String   @map("campaign_id")
  clientId      String   @map("client_id")
  /// The transaction that earned this ticket (unique per campaign)
  transactionId String   @map("transaction_id")
  used          Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  campaign    LuckyWheelCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transaction Transaction        @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  draw        LuckyWheelDraw?

  @@unique([transactionId, campaignId])
  @@index([clientId, campaignId])
  @@index([campaignId, used])
  @@map("lucky_wheel_tickets")
}

/// A draw attempt — always server-generated, immutable
model LuckyWheelDraw {
  id          String                 @id @default(uuid())
  ticketId    String                 @unique @map("ticket_id")
  prizeId     String?                @map("prize_id")
  result      DrawResult
  /// Prize fulfilment status (only set when result = WON)
  fulfilment  PrizeFulfilmentStatus?
  /// Deadline for the client to claim the prize
  claimBefore DateTime?              @map("claim_before")
  /// Merchant confirms prize handed over
  fulfilledAt DateTime?              @map("fulfilled_at")
  /// Who confirmed fulfilment (merchant or team member ID)
  fulfilledBy String?                @map("fulfilled_by")
  /// Server-generated cryptographic nonce proving the draw was fair
  serverSeed  String                 @map("server_seed") @db.VarChar(64)
  createdAt   DateTime               @default(now()) @map("created_at")

  ticket LuckyWheelTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  prize  LuckyWheelPrize? @relation(fields: [prizeId], references: [id], onDelete: SetNull)

  @@index([prizeId])
  @@index([fulfilment])
  @@index([result, createdAt(sort: Desc)])
  @@map("lucky_wheel_draws")
}

/// Client-initiated block of a merchant. App Store Guideline 1.2 requires apps
/// with user-generated content to let end-users block abusive users. A blocked
/// merchant is hidden from discovery (list + detail) and cannot appear in
/// lucky-wheel / notifications for this client.
model ClientMerchantBlock {
  id         String   @id @default(uuid())
  clientId   String   @map("client_id")
  merchantId String   @map("merchant_id")
  createdAt  DateTime @default(now()) @map("created_at")

  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([clientId, merchantId])
  @@index([merchantId])
  @@map("client_merchant_blocks")
}

// ══════════════════════════════════════════════════════════════════════════════
// ── Scratch cards (free promotional cards — every card wins a coupon) ─────────
// ══════════════════════════════════════════════════════════════════════════════

enum ScratchCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  ENDED
  CANCELLED
}

enum ScratchCardStatus {
  PENDING
  SCRATCHED
  EXPIRED
  CANCELLED
}

enum ScratchAudienceType {
  ALL_CLIENTS
  /// Visited within the last `audienceValue` days
  ACTIVE_SINCE
  /// No visit for at least `audienceValue` days
  INACTIVE_SINCE
  /// At least `audienceValue` stamps on their card
  MIN_STAMPS
  /// Joined the programme within the last `audienceValue` days
  NEW_SINCE
}

enum CouponRewardType {
  PERCENT_DISCOUNT
  FIXED_DISCOUNT
  FREE_PRODUCT
  BONUS_STAMPS
}

enum CouponStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

enum CouponSource {
  SCRATCH_CARD
  LUCKY_WHEEL
  MANUAL
  /// Gift of a completed collection
  COLLECTION
}

model ScratchCampaign {
  id               String                @id @default(uuid())
  merchantId       String                @map("merchant_id")
  name             String                @db.VarChar(80)
  /// Optional merchant message shown on the card and in the push body (moderated)
  message          String?               @db.VarChar(200)
  /// Key of a shared card design (packages/shared/src/scratch/designs.ts)
  designId         String                @default("violet") @map("design_id") @db.VarChar(32)
  status           ScratchCampaignStatus @default(DRAFT)
  audienceType     ScratchAudienceType   @default(ALL_CLIENTS) @map("audience_type")
  audienceValue    Int?                  @map("audience_value")
  sendAt           DateTime?             @map("send_at")
  /// Set when an instance claims the campaign for dispatch; stale locks are retaken
  sendingLockedAt  DateTime?             @map("sending_locked_at")
  sentAt           DateTime?             @map("sent_at")
  cancelledAt      DateTime?             @map("cancelled_at")
  /// Last moment a card can be scratched (end of day, Morocco time)
  cardExpiresAt    DateTime              @map("card_expires_at")
  /// Last moment a won coupon can be used (end of day, Morocco time)
  couponExpiresAt  DateTime              @map("coupon_expires_at")
  recipientCount   Int                   @default(0) @map("recipient_count")
  pushSuccessCount Int                   @default(0) @map("push_success_count")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  merchant Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  rewards  ScratchReward[]
  cards    ScratchCard[]

  @@index([merchantId, status])
  @@index([status, sendAt])
  @@map("scratch_campaigns")
}

model ScratchReward {
  id                String           @id @default(uuid())
  campaignId        String           @map("campaign_id")
  type              CouponRewardType
  label             String           @db.VarChar(80)
  /// Percent (1-100), amount in MAD, or number of bonus stamps depending on `type`
  value             Float?
  /// Upper bound of the discount for PERCENT_DISCOUNT (MAD)
  maxDiscount       Float?           @map("max_discount")
  /// Optional link to the merchant's reward catalogue (FREE_PRODUCT)
  rewardId          String?          @map("reward_id")
  weight            Int
  /// null = unlimited stock (every campaign needs at least one unlimited reward)
  totalStock        Int?             @map("total_stock")
  remaining         Int?
  minPurchaseAmount Float?           @map("min_purchase_amount")
  /// Hours after scratching before the coupon becomes usable ("next visit")
  minDelayHours     Int              @default(0) @map("min_delay_hours")
  /// Bitmask Monday=1 … Sunday=64 (null = every day)
  allowedWeekdays   Int?             @map("allowed_weekdays")
  /// Minutes since midnight, Morocco time (null = all day)
  allowedFromMin    Int?             @map("allowed_from_min")
  allowedToMin      Int?             @map("allowed_to_min")
  createdAt         DateTime         @default(now()) @map("created_at")

  campaign ScratchCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  reward   Reward?         @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  cards    ScratchCard[]

  @@index([campaignId])
  @@map("scratch_rewards")
}

model ScratchCard {
  id                 String            @id @default(uuid())
  campaignId         String            @map("campaign_id")
  clientId           String            @map("client_id")
  /// Denormalised for merchant-scoped queries
  merchantId         String            @map("merchant_id")
  /// Filled when the card is scratched
  rewardId           String?           @map("reward_id")
  status             ScratchCardStatus @default(PENDING)
  pushSentAt         DateTime?         @map("push_sent_at")
  openedAt           DateTime?         @map("opened_at")
  scratchedAt        DateTime?         @map("scratched_at")
  expiresAt          DateTime          @map("expires_at")
  reminderSentAt     DateTime?         @map("reminder_sent_at")
  /// Set when the card moved from a ghost (quick-add) account to a real one
  claimedFromGhostAt DateTime?         @map("claimed_from_ghost_at")
  createdAt          DateTime          @default(now()) @map("created_at")

  campaign ScratchCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  client   Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reward   ScratchReward?  @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  coupon   Coupon?

  @@unique([campaignId, clientId])
  @@index([clientId, status])
  @@index([campaignId, status])
  @@index([status, expiresAt])
  @@index([merchantId, status])
  // FK reward_id (ON DELETE SET NULL): deleting a reward must not scan scratch_cards.
  @@index([rewardId])
  @@map("scratch_cards")
}

model Coupon {
  id                  String           @id @default(uuid())
  source              CouponSource     @default(SCRATCH_CARD)
  scratchCardId       String?          @unique @map("scratch_card_id")
  clientId            String           @map("client_id")
  merchantId          String           @map("merchant_id")
  /// 6 digits, unique among ACTIVE coupons of a merchant (partial index in migration)
  code                String           @db.Char(6)
  // Snapshot of the reward: editing a campaign never changes a coupon already won
  type                CouponRewardType
  label               String           @db.VarChar(80)
  value               Float?
  maxDiscount         Float?           @map("max_discount")
  /// { minPurchaseAmount, allowedWeekdays, allowedFromMin, allowedToMin }
  conditions          Json
  status              CouponStatus     @default(ACTIVE)
  validFrom           DateTime         @map("valid_from")
  expiresAt           DateTime         @map("expires_at")
  reminderSentAt      DateTime?        @map("reminder_sent_at")
  redeemedAt          DateTime?        @map("redeemed_at")
  /// Merchant id or team member id
  redeemedBy          String?          @map("redeemed_by")
  cancelledAt         DateTime?        @map("cancelled_at")
  /// Ticket total before discount, as typed by the cashier
  purchaseAmount      Float?           @map("purchase_amount")
  discountAmount      Float?           @map("discount_amount")
  redeemTransactionId String?          @unique @map("redeem_transaction_id")
  earnTransactionId   String?          @unique @map("earn_transaction_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  scratchCard ScratchCard? @relation(fields: [scratchCardId], references: [id], onDelete: SetNull)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  merchant    Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  /// Set for a COLLECTION coupon: the completed cycle that won it
  collectionProgress CollectionProgress?

  @@index([clientId, status])
  @@index([merchantId, status])
  @@index([merchantId, source, status])
  @@index([merchantId, code])
  @@index([status, expiresAt])
  @@map("coupons")
}

// ══════════════════════════════════════════════════════════════════════════════
// ── Bons plans (public promotions, independent of the loyalty programme) ─────
// ══════════════════════════════════════════════════════════════════════════════

enum DealType {
  BUY_X_GET_Y
  PERCENT_OFF
  PRICE_DROP
  FREE_ITEM
  OTHER
}

enum DealScope {
  /// In store, found "near me" through the stores it applies to
  LOCAL
  /// E-commerce: a mandatory https link, visible in the whole country
  ONLINE
}

enum DealStatus {
  /// Published; visible while startsAt <= now < endsAt
  ACTIVE
  ENDED
  /// Taken down by moderation (admin or too many reports)
  REMOVED
  /// Deleted by the merchant (kept until the purge for moderation history)
  DELETED
}

model Deal {
  id              String     @id @default(uuid())
  merchantId      String     @map("merchant_id")
  scope           DealScope  @default(LOCAL)
  type            DealType
  title           String     @db.VarChar(60)
  description     String?    @db.VarChar(300)
  conditions      String?    @db.VarChar(200)
  imageUrl        String?    @map("image_url") @db.VarChar(500)
  linkUrl         String?    @map("link_url") @db.VarChar(500)
  originalPrice   Decimal?   @map("original_price") @db.Decimal(10, 2)
  dealPrice       Decimal?   @map("deal_price") @db.Decimal(10, 2)
  /// Given for PERCENT_OFF, computed for PRICE_DROP (used to rank alerts)
  percentOff      Int?       @map("percent_off")
  buyQty          Int?       @map("buy_qty")
  freeQty         Int?       @map("free_qty")
  /// "À partir de" in front of the price
  priceFrom       Boolean    @default(false) @map("price_from")
  /// PIECE | KG | PERSON | HOUR | NIGHT | MONTH: what the price counts for
  priceUnit       String?    @map("price_unit") @db.VarChar(10)
  /// true = every active store of the merchant, now and later
  allStores       Boolean    @default(true) @map("all_stores")
  /// MOROCCO_CITIES keys of the stores concerned (empty for ONLINE)
  cityKeys        String[]   @default([]) @map("city_keys")
  startsAt        DateTime   @map("starts_at")
  /// End of the last day, Morocco time
  endsAt          DateTime   @map("ends_at")
  status          DealStatus @default(ACTIVE)
  /// EXPIRED | STOPPED | AUTO_REPORTS | moderation reason typed by an admin
  endedReason     String?    @map("ended_reason") @db.VarChar(200)
  alertSentAt     DateTime?  @map("alert_sent_at")
  /// Set once the clients holding the merchant's loyalty card were told about the deal
  cardAlertSentAt DateTime?  @map("card_alert_sent_at")
  /// Recomputed every 15 min by DealsMaintenanceService
  isPopular       Boolean    @default(false) @map("is_popular")
  reportCount     Int        @default(0) @map("report_count")
  viewCount       Int        @default(0) @map("view_count")
  linkClickCount  Int        @default(0) @map("link_click_count")
  directionsCount Int        @default(0) @map("directions_count")
  shareCount      Int        @default(0) @map("share_count")
  callCount       Int        @default(0) @map("call_count")
  /// Clients who tapped "J'en profite" (one DealClaim each)
  claimCount      Int        @default(0) @map("claim_count")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  merchant     Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  stores       DealStore[]
  reports      DealReport[]
  claims       DealClaim[]
  saves        DealSave[]
  dailyStats   DealDailyStat[]
  eventMarks   DealEventMark[]
  offerChanges DealOfferChange[]

  @@index([status, endsAt])
  @@index([scope, status, endsAt])
  @@index([status, startsAt])
  @@index([merchantId, status])
  @@index([cityKeys], type: Gin)
  @@map("deals")
}

/// Stores a deal applies to when allStores = false
model DealStore {
  dealId  String @map("deal_id")
  storeId String @map("store_id")

  deal  Deal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([dealId, storeId])
  @@index([storeId])
  @@map("deal_stores")
}

model DealReport {
  id        String   @id @default(uuid())
  dealId    String   @map("deal_id")
  clientId  String   @map("client_id")
  /// INAPPROPRIATE | MISLEADING | OFF_TOPIC | EXPIRED | OTHER
  reason    String   @db.VarChar(40)
  comment   String?  @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at")

  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([dealId, clientId])
  @@index([clientId])
  @@map("deal_reports")
}

/// "J'en profite": the client shows the pass at the till. One per client and deal.
model DealClaim {
  dealId    String   @map("deal_id")
  clientId  String   @map("client_id")
  createdAt DateTime @default(now()) @map("created_at")

  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([dealId, clientId])
  @@index([clientId])
  @@map("deal_claims")
}

/// Deal bookmarked by a client ("Enregistrés" tab, reminder the day before it ends)
model DealSave {
  clientId   String    @map("client_id")
  dealId     String    @map("deal_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  /// Set when the "ends tomorrow" push was sent
  remindedAt DateTime? @map("reminded_at")

  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, dealId])
  @@index([dealId, remindedAt])
  @@map("deal_saves")
}

/// Figures of a deal for one Morocco day (the merchant's chart)
model DealDailyStat {
  dealId  String   @map("deal_id")
  day     DateTime @db.Date
  views   Int      @default(0)
  /// Link clicks, directions and calls
  actions Int      @default(0)
  claims  Int      @default(0)

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@id([dealId, day])
  @@map("deal_daily_stats")
}

/// Proof that a viewer's view or click was counted that day, shared by every
/// instance. viewerKey is the client id, or a keyed hash of a guest's IP.
/// Purged after DEAL_EVENT_MARK_RETENTION_DAYS.
model DealEventMark {
  dealId    String   @map("deal_id")
  viewerKey String   @map("viewer_key") @db.VarChar(64)
  /// VIEW | LINK_CLICK | DIRECTIONS | SHARE | CALL
  kind      String   @db.VarChar(12)
  day       DateTime @db.Date

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@id([dealId, viewerKey, kind, day])
  @@index([day])
  @@map("deal_event_marks")
}

/// Offer of a published deal before and after an edit (prices, discount, type),
/// for the moderation of "misleading" reports
model DealOfferChange {
  id        String   @id @default(uuid())
  dealId    String   @map("deal_id")
  before    Json
  after     Json
  createdAt DateTime @default(now()) @map("created_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt])
  @@map("deal_offer_changes")
}

// ══════════════════════════════════════════════════════════════════════════════
// ── QR e-commerce (single-use codes slipped into parcels / deliveries) ───────
// ══════════════════════════════════════════════════════════════════════════════

enum StampCodeStatus {
  ACTIVE
  REDEEMED
  REVOKED
}

/// Single-use QR code a merchant prints and slips into a parcel. Scanning it
/// credits `stamps` to the client (one EARN_STAMPS transaction). The token in
/// the QR is derived from the id with an HMAC (StampCodeTokenService), so no
/// secret is stored and a batch can be reprinted. Codes never expire.
model StampCode {
  id                 String          @id @default(uuid())
  merchantId         String          @map("merchant_id")
  /// Codes created together share a batchId (one print sheet)
  batchId            String          @map("batch_id")
  label              String          @db.VarChar(80)
  /// Snapshot taken at creation: a printed label keeps its value
  stamps             Int
  /// Order amount the stamps were computed from (0 when set as a stamp count)
  amount             Float           @default(0)
  status             StampCodeStatus @default(ACTIVE)
  redeemedAt         DateTime?       @map("redeemed_at")
  redeemedByClientId String?         @map("redeemed_by_client_id")
  createdAt          DateTime        @default(now()) @map("created_at")

  merchant         Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  redeemedByClient Client?      @relation(fields: [redeemedByClientId], references: [id], onDelete: SetNull)
  transaction      Transaction?

  // FREE monthly quota + batch listing
  @@index([merchantId, createdAt])
  @@index([batchId, status])
  @@index([redeemedByClientId])
  @@map("stamp_codes")
}

// ── Admin back-office: merchant follow-up (CRM) and subscription billing ──────

enum PremiumGrant {
  /// The merchant pays for PREMIUM
  PAID
  /// PREMIUM given for free (partner, test, goodwill…)
  OFFERED
}

enum FollowUpStatus {
  TO_CONTACT
  CONTACTED
  INTERESTED
  ONBOARDING
  CONVERTED
  LOST
}

enum FollowUpKind {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  VISIT
}

enum SubscriptionPaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

/// One row per merchant the team follows: pipeline status and next planned action.
model MerchantFollowUp {
  merchantId   String         @id @map("merchant_id")
  status       FollowUpStatus @default(TO_CONTACT)
  /// When the next action is due (null = nothing planned)
  nextActionAt DateTime?      @map("next_action_at")
  nextAction   String?        @map("next_action") @db.VarChar(200)
  /// Admin in charge (email)
  owner        String?        @db.VarChar(255)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  // "À relancer" queue: open follow-ups sorted by due date
  @@index([status, nextActionAt])
  @@index([nextActionAt])
  @@map("merchant_follow_ups")
}

/// Timeline of contacts and notes written by admins about a merchant.
model MerchantFollowUpNote {
  id         String       @id @default(uuid())
  merchantId String       @map("merchant_id")
  kind       FollowUpKind @default(NOTE)
  body       String       @db.VarChar(2000)
  adminId    String?      @map("admin_id")
  adminEmail String?      @map("admin_email") @db.VarChar(255)
  createdAt  DateTime     @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("merchant_follow_up_notes")
}

/// Money actually received for a PREMIUM subscription (recorded by an admin).
/// Never deleted: a mistaken entry is voided so revenue history stays auditable.
model MerchantSubscriptionPayment {
  id          String                    @id @default(uuid())
  merchantId  String                    @map("merchant_id")
  amount      Float
  currency    String                    @default("MAD") @db.VarChar(3)
  method      SubscriptionPaymentMethod
  paidAt      DateTime                  @map("paid_at")
  /// Period covered by the payment
  periodStart DateTime?                 @map("period_start")
  periodEnd   DateTime?                 @map("period_end")
  reference   String?                   @db.VarChar(120)
  note        String?                   @db.VarChar(500)
  adminId     String?                   @map("admin_id")
  adminEmail  String?                   @map("admin_email") @db.VarChar(255)
  voidedAt    DateTime?                 @map("voided_at")
  voidReason  String?                   @map("void_reason") @db.VarChar(300)
  createdAt   DateTime                  @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, paidAt(sort: Desc)])
  @@index([paidAt(sort: Desc)])
  @@map("merchant_subscription_payments")
}

// ══════════════════════════════════════════════════════════════════════════════
// ── Booking (appointments taken from the JitPlus app, open to every plan) ─────
// ══════════════════════════════════════════════════════════════════════════════

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED_CLIENT
  CANCELLED_MERCHANT
  DECLINED
  EXPIRED
  NO_SHOW
}

enum BookingSource {
  APP
  MERCHANT
}

enum AvailabilityExceptionType {
  CLOSED
  OPEN
}

/// One row per merchant once booking has been set up
model BookingSettings {
  merchantId          String   @id @map("merchant_id")
  enabled             Boolean  @default(false)
  /// false = every request waits for the merchant (PENDING)
  autoConfirm         Boolean  @default(true) @map("auto_confirm")
  minNoticeMinutes    Int      @default(60) @map("min_notice_minutes")
  maxAdvanceDays      Int      @default(30) @map("max_advance_days")
  cancelDeadlineHours Int      @default(2) @map("cancel_deadline_hours")
  slotStepMinutes     Int      @default(15) @map("slot_step_minutes")
  /// After this many NO_SHOW at this merchant, the client's requests need approval
  noShowLimit         Int      @default(3) @map("no_show_limit")
  /// Bookings taken at the same time (1-10): extra seats copy the main calendar's hours and services.
  capacity            Int      @default(1)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("booking_settings")
}

/// Admin-managed catalogue of service names per category. No duration, no
/// price: the merchant always sets those on his own BookableService.
model ServiceTemplate {
  id          String           @id @default(uuid())
  category    MerchantCategory
  nom         String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  order       Int              @default(0)
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")

  services BookableService[]

  @@unique([category, nom])
  @@index([category, isActive, order])
  @@map("service_templates")
}

/// A service the merchant offers. templateId null = custom service created by the merchant.
model BookableService {
  id          String    @id @default(uuid())
  merchantId  String    @map("merchant_id")
  templateId  String?   @map("template_id")
  nom         String    @db.VarChar(120)
  description String?   @db.VarChar(500)
  /// Set by the merchant, never by the catalogue
  durationMin Int       @map("duration_min")
  /// Cleaning / preparation time blocked after the service
  bufferMin   Int       @default(0) @map("buffer_min")
  priceFrom   Decimal?  @map("price_from") @db.Decimal(10, 2)
  isActive    Boolean   @default(true) @map("is_active")
  order       Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  merchant  Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  template  ServiceTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  resources ServiceResource[]
  bookings  Booking[]

  @@index([merchantId, deletedAt, isActive])
  @@index([templateId])
  @@map("bookable_services")
}

/// Who can be booked: the owner (teamMemberId null) or a team member
model BookingResource {
  id           String   @id @default(uuid())
  merchantId   String   @map("merchant_id")
  teamMemberId String?  @unique @map("team_member_id")
  storeId      String?  @map("store_id")
  nom          String   @db.VarChar(120)
  isActive     Boolean  @default(true) @map("is_active")
  order        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  merchant     Merchant                @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  teamMember   TeamMember?             @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  store        Store?                  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  services     ServiceResource[]
  workingHours WorkingHours[]
  exceptions   AvailabilityException[]
  bookings     Booking[]

  @@index([merchantId, isActive])
  @@map("booking_resources")
}

model ServiceResource {
  serviceId  String @map("service_id")
  resourceId String @map("resource_id")

  service  BookableService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource BookingResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([serviceId, resourceId])
  @@index([resourceId])
  @@map("service_resources")
}

/// Weekly hours of a resource, in the merchant's local wall-clock time.
/// Several rows on one weekday = breaks between them.
model WorkingHours {
  id         String @id @default(uuid())
  resourceId String @map("resource_id")
  /// 1 = Monday … 7 = Sunday
  weekday    Int
  /// Minutes since local midnight
  startMin   Int    @map("start_min")
  endMin     Int    @map("end_min")

  resource BookingResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, weekday])
  @@map("working_hours")
}

/// Holidays, closures (CLOSED) or extra opening (OPEN). resourceId null = whole merchant.
model AvailabilityException {
  id         String                    @id @default(uuid())
  merchantId String                    @map("merchant_id")
  resourceId String?                   @map("resource_id")
  type       AvailabilityExceptionType @default(CLOSED)
  startsAt   DateTime                  @map("starts_at")
  endsAt     DateTime                  @map("ends_at")
  reason     String?                   @db.VarChar(200)
  createdAt  DateTime                  @default(now()) @map("created_at")

  merchant Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  resource BookingResource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([merchantId, startsAt])
  @@index([resourceId, startsAt])
  @@map("availability_exceptions")
}

model Booking {
  id                    String        @id @default(uuid())
  merchantId            String        @map("merchant_id")
  serviceId             String        @map("service_id")
  resourceId            String        @map("resource_id")
  /// null = walk-in / phone booking typed by the merchant without a JitPlus account
  clientId              String?       @map("client_id")
  clientName            String?       @map("client_name") @db.VarChar(120)
  clientPhone           String?       @map("client_phone") @db.VarChar(20)
  startsAt              DateTime      @map("starts_at")
  endsAt                DateTime      @map("ends_at")
  /// endsAt + bufferMin: the range the no-overlap constraint protects
  blockedUntil          DateTime      @map("blocked_until")
  status                BookingStatus
  source                BookingSource @default(APP)
  /// Max 200 chars, never medical information
  note                  String?       @db.VarChar(200)
  serviceNameSnapshot   String        @map("service_name_snapshot") @db.VarChar(120)
  priceSnapshot         Decimal?      @map("price_snapshot") @db.Decimal(10, 2)
  idempotencyKey        String?       @map("idempotency_key") @db.VarChar(64)
  confirmedAt           DateTime?     @map("confirmed_at")
  checkedInAt           DateTime?     @map("checked_in_at")
  checkInTransactionId  String?       @unique @map("check_in_transaction_id")
  cancelledAt           DateTime?     @map("cancelled_at")
  cancelReason          String?       @map("cancel_reason") @db.VarChar(200)
  reminderDaySentAt     DateTime?     @map("reminder_day_sent_at")
  reminderHourSentAt    DateTime?     @map("reminder_hour_sent_at")
  /// Merchant reminded that this request is about to expire unanswered
  pendingReminderSentAt DateTime?     @map("pending_reminder_sent_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  merchant Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  service  BookableService @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  resource BookingResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  client   Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([clientId, idempotencyKey])
  @@index([merchantId, startsAt])
  @@index([resourceId, startsAt])
  @@index([clientId, startsAt])
  @@index([status, startsAt])
  @@map("bookings")
}

// ══════════════════════════════════════════════════════════════════════════════
// ── Collection game: buy every product of a set, win the gift the merchant chose
// ══════════════════════════════════════════════════════════════════════════════
enum CollectionStatus {
  DRAFT
  ACTIVE
  ENDED
}

/// A set of products / services to buy (items) and the gift offered once all
/// of them are collected. One ACTIVE collection per merchant (partial unique
/// index collections_one_active_per_merchant, raw SQL migration).
model Collection {
  id                 String           @id @default(uuid())
  merchantId         String           @map("merchant_id")
  name               String           @db.VarChar(80)
  /// The gift, chosen by the merchant ("celui-ci est offert"). Copied on the coupon.
  giftLabel          String           @map("gift_label") @db.VarChar(80)
  /// Optional photo of the gift. Deleted from storage when the collection ends, like the product photos.
  giftImageUrl       String?          @map("gift_image_url") @db.VarChar(500)
  status             CollectionStatus @default(DRAFT)
  /// true = at most one item per client and per day (Morocco time)
  onePerVisit        Boolean          @default(false) @map("one_per_visit")
  /// true = a new cycle starts after the gift is won
  repeatable         Boolean          @default(true)
  /// Days the gift coupon stays usable once won
  couponValidityDays Int              @default(30) @map("coupon_validity_days")
  /// Hours after completion before the gift can be used ("next visit")
  giftDelayHours     Int              @default(0) @map("gift_delay_hours")
  /// Optional end (end of day, Morocco time). Progress stops, coupons already won stay valid.
  endsAt             DateTime?        @map("ends_at")
  startedAt          DateTime?        @map("started_at")
  endedAt            DateTime?        @map("ended_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  merchant Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  items    CollectionItem[]
  progress CollectionProgress[]

  @@index([merchantId, status])
  @@map("collections")
}

/// One product / service to collect. The set is frozen once the collection is ACTIVE (labels only).
model CollectionItem {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  label        String   @db.VarChar(60)
  /// Optional photo of the product. Deleted from storage when the collection ends.
  imageUrl     String?  @map("image_url") @db.VarChar(500)
  position     Int
  createdAt    DateTime @default(now()) @map("created_at")

  collection Collection        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  checks     CollectionCheck[]

  @@index([collectionId, position])
  @@map("collection_items")
}

/// One cycle of a client on a collection. A repeatable collection opens cycle n+1 after the gift.
model CollectionProgress {
  id           String    @id @default(uuid())
  collectionId String    @map("collection_id")
  clientId     String    @map("client_id")
  /// Denormalised for merchant-scoped queries
  merchantId   String    @map("merchant_id")
  cycle        Int       @default(1)
  completedAt  DateTime? @map("completed_at")
  /// Gift coupon created when the cycle was completed
  couponId     String?   @unique @map("coupon_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  collection Collection        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  coupon     Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  checks     CollectionCheck[]

  @@unique([collectionId, clientId, cycle])
  @@index([clientId, merchantId])
  @@map("collection_progress")
}

/// An item ticked at the till for a client. Unique per cycle: ticking twice is a no-op.
model CollectionCheck {
  id              String   @id @default(uuid())
  progressId      String   @map("progress_id")
  itemId          String   @map("item_id")
  /// Who ticked it (null = the owner)
  teamMemberId    String?  @map("team_member_id")
  performedByName String?  @map("performed_by_name") @db.VarChar(255)
  /// Idempotency-Key of the till request that ticked it: a retry is recognised
  /// even after the cycle was completed and a new one could start.
  requestKey      String?  @map("request_key") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at")

  progress CollectionProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  item     CollectionItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([progressId, itemId])
  @@index([itemId])
  @@index([requestKey])
  @@map("collection_checks")
}
