# ── Développement local ───────────────────────────────────────────
# Format TCP (docker-compose ou postgres local)
DATABASE_URL="postgresql://admin:CHANGE_ME_STRONG_PASSWORD@localhost:5432/jit_db?schema=public"
# Format Cloud SQL unix socket (Cloud Run) :
# DATABASE_URL="postgresql://USER:PASS@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE"

JWT_SECRET="CHANGE_ME_USE_openssl_rand_-base64_64_to_generate"
JWT_EXPIRATION="1h"

# Separate HMAC key for QR tokens (recommended — falls back to JWT_SECRET if empty)
QR_HMAC_SECRET="CHANGE_ME_USE_openssl_rand_-base64_32_to_generate"
# Optional: HMAC key for coupon QR codes (scratch cards). Falls back to QR_HMAC_SECRET.
COUPON_HMAC_SECRET=""

PORT=3000
# Number of trusted reverse proxies. Cloud Run: 1; direct local access: 0.
# Set this to match the deployment, never trust arbitrary forwarded headers.
TRUST_PROXY_HOPS=1

# Sentry — error monitoring (laisser vide pour désactiver)
SENTRY_DSN=""

# Cache — en mémoire (in-process). Suffisant pour une seule instance Cloud Run.
# Pour un déploiement multi-instances, envisager un cache externe (ex : Memorystore).

# CORS origins (CSV) — requis en production
# Exemple: https://jitplus.ma,https://admin.jitplus.ma
CORS_ORIGINS=""

# Resend API key — emails transactionnels (REQUIS en production)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# URL publique du backend — utilisée pour les images dans les push notifications
# En production : URL Cloud Run (ex: https://jitplus-api-xxx-ew.a.run.app)
BACKEND_URL="http://localhost:3000"

# ── Firebase Admin SDK — Push Notifications (REQUIS en production) ────
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ── SMTP — Gmail (utiliser un "Mot de passe d'application" Google) ─────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="contact@jitplus.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="JitPlus <contact@jitplus.com>"
# Adresse vers laquelle les destinataires répondent (fallback sur SMTP_FROM si non défini)
SMTP_REPLY_TO="contact@jitplus.com"

# ── Modération UGC (Apple 1.2 / Play UGC) ────────────────────
# Boîte mail qui reçoit les signalements clients. Si non défini, fallback sur ADMIN_EMAIL puis "contact@jitplus.com".
MODERATION_EMAIL="contact@jitplus.com"

# ── Google Cloud Platform ─────────────────────────────────────
# REQUIS en production — pas nécessaire en local si on ne teste pas l'upload
GCP_PROJECT_ID="jitplus-97259"
GCP_STORAGE_BUCKET_NAME="jitplus-uploads-prod"

# Nom de l'instance Cloud SQL (utilisé dans cloudbuild.yaml pour le flag --add-cloudsql-instances)
# Format : PROJECT:REGION:INSTANCE
CLOUD_SQL_INSTANCE="jitplus-97259:europe-west9:jitplus-db"

# En développement local seulement : chemin vers le JSON de compte de service
# Sur Cloud Run, l'auth est automatique via le compte de service attaché — ne pas définir.
# GOOGLE_APPLICATION_CREDENTIALS="./jitplus-97259-key.json"

# ── Google OAuth (connexion client & commerçant) ───────────────
GOOGLE_CLIENT_ID=""
# Android Client IDs — comma-separated for jitplus + jitpluspro (type=1 SHA-1 keyed)
GOOGLE_ANDROID_CLIENT_ID=""

# ── Apple Sign-In ─────────────────────────────────────────────
# Required in production. Include the exact bundle/service IDs used by both apps.
# Comma-separated IDs for audience validation (e.g. "com.jitplus.client,com.jitplus.pro")
APPLE_BUNDLE_IDS=""

# -- Force-update / Maintenance ----------------------------
# GET /health/version?app=jitplus|jitpluspro returns the minimum version for
# that app. Each per-app variable falls back to the legacy pair when unset.
MIN_IOS_VERSION_JITPLUS=1.4.0
MIN_ANDROID_VERSION_JITPLUS=1.4.0
MIN_IOS_VERSION_JITPLUSPRO=1.6.0
MIN_ANDROID_VERSION_JITPLUSPRO=1.6.0
# Legacy pair, used by builds that do not send ?app= (or send an unknown value)
MIN_IOS_VERSION=1.0.0
MIN_ANDROID_VERSION=1.0.0
MAINTENANCE_MODE=false


# Scratch cards: run the campaign dispatcher even when ENABLE_CRONS is off (it runs anyway when crons are on)
# ENABLE_SCRATCH_DISPATCH=true
# Local testing only, never honoured in production: send scratch campaigns during quiet hours
# SCRATCH_IGNORE_QUIET_HOURS=true
