      "@eslint/eslintrc>ajv": "^6.12.6",
      "@tootallnate/once": ">=3.0.1",
      "picomatch": ">=4.0.4",
      "follow-redirects": ">=1.16.0",
      "shell-quote": "^1.8.4",
      "@grpc/grpc-js": "^1.14.4",
      "axios": "^1.16.0",
      "fast-uri": "^3.1.6",
      "browserslist": "^4.28.7",
      "multer": "^2.2.0",
