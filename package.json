{
  "name": "jit-plus-workspace",
  "version": "1.0.1",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "start": "pnpm run --parallel start",
    "dev": "pnpm run --parallel dev",
    "build": "pnpm run --parallel build",
    "eas:build:jitplus:android": "eas build --platform android --profile production --project-dir apps/jitplus",
    "eas:submit:jitplus:android": "eas submit --platform android --profile production --project-dir apps/jitplus",
    "test": "pnpm run --parallel test",
    "lint": "pnpm run --parallel lint"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "lodash": "4.18.1",
      "path-to-regexp": "8.4.0",
      "ajv": ">=8.18.0",
      "eslint>ajv": "^6.12.6",
      "@eslint/eslintrc>ajv": "^6.12.6",
      "@tootallnate/once": ">=3.0.1",
      "picomatch": ">=4.0.4",
      "follow-redirects": ">=1.16.0",
      "shell-quote": "^1.8.4",
      "@grpc/grpc-js": "^1.14.4",
      "axios": "^1.16.0",
      "fast-uri": "^3.1.2",
      "fast-xml-builder": "^1.1.7",
      "form-data": "^4.0.6",
      "nodemailer": "^9.0.1",
      "react-router": "^7.15.1",
      "ws": "^8.21.0",
      "@opentelemetry/core": "^2.8.0",
      "postcss": "^8.5.10",
      "qs": "^6.15.2",
      "tar": "^7.5.16",
      "vite": "^6.4.3",
      "esbuild": "^0.25.0",
      "undici": "^8.5.0",
      "brace-expansion@5": "^5.0.6",
      "js-yaml@3": "^3.15.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "protobufjs"
    ]
  },
  "dependencies": {
    "firebase-admin": "^13.8.0",
    "uuid": "^14.0.0"
  }
}
